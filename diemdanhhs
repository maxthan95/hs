            const selectedMonth = document.getElementById('monthlyStatsDate').value;
            if (!selectedMonth) return;

            // Đảm bảo students là mảng và attendanceRecords là object
            if (!Array.isArray(students)) {
                students = [];
            }
            if (typeof attendanceRecords !== 'object' || attendanceRecords === null) {
                attendanceRecords = {};
            }

            const [year, month] = selectedMonth.split('-');
            const daysInMonth = new Date(year, month, 0).getDate();
            
            // Tính toán thống kê tháng
            const monthlyData = {};
            students.forEach(student => {
                monthlyData[student.id] = {
                    student: student,
                    present: 0,
                    absent: 0,
                    late: 0,
                    total: 0
                };
            });

            // Duyệt qua tất cả ngày trong tháng
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${month.padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
                const dayAttendance = attendanceRecords[dateStr] || {};
                
                students.forEach(student => {
