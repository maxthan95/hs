        // Lưu tự động với debounce
        function autoSave() {
            // Clear timeout cũ nếu có
            if (saveTimeout) {
                clearTimeout(saveTimeout);
            }
            
            // Đặt timeout mới để lưu sau 2 giây
            saveTimeout = setTimeout(() => {
                saveData(false); // Không hiển thị thông báo cho auto-save
                showSaveNotification('💾 Tự động lưu...', 'info', 1000);
            }, 2000);
