        // Các hàm hỗ trợ
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('vi-VN');
        }

        function calculateDayStats(dayAttendance) {
            let present = 0, absent = 0, late = 0;
            let banTruPresent = 0, khongBanTruPresent = 0;
            let banTruTotal = 0, khongBanTruTotal = 0;

            students.forEach(student => {
                const status = dayAttendance[student.id] || 'present';
                
                if (student.type === 'Bán trú') {
                    banTruTotal++;
                    if (status === 'present' || status === 'late') banTruPresent++;
                } else {
                    khongBanTruTotal++;
                    if (status === 'present' || status === 'late') khongBanTruPresent++;
                }
                
                switch(status) {
                    case 'present': present++; break;
                    case 'absent': absent++; break;
                    case 'late': late++; break;
                }
            });

            const total = students.length;
            return {
                total,
                present,
                absent,
                late,
                presentPercent: total > 0 ? ((present/total)*100).toFixed(1) : 0,
                absentPercent: total > 0 ? ((absent/total)*100).toFixed(1) : 0,
                latePercent: total > 0 ? ((late/total)*100).toFixed(1) : 0,
                banTruPresent,
                banTruTotal,
                khongBanTruPresent,
                khongBanTruTotal
            };
        }

        function calculateMonthlyStats(year, month, daysInMonth) {
            const studentData = {};
            students.forEach(student => {
                studentData[student.id] = {
                    student: student,
                    present: 0,
                    absent: 0,
                    late: 0,
                    total: 0
                };
            });

            // Duyệt qua tất cả ngày trong tháng
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${month.padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
                const dayAttendance = attendanceRecords[dateStr] || {};
                
                students.forEach(student => {
                    const status = dayAttendance[student.id] || 'present';
                    studentData[student.id].total++;
                    
                    switch(status) {
                        case 'present': 
                            studentData[student.id].present++; 
                            break;
                        case 'absent': 
                            studentData[student.id].absent++; 
                            break;
                        case 'late': 
                            studentData[student.id].late++; 
                            break;
                    }
                });
            }

            // Tính tổng
            let totalPresent = 0, totalAbsent = 0, totalLate = 0;
            Object.values(studentData).forEach(data => {
                totalPresent += data.present;
                totalAbsent += data.absent;
                totalLate += data.late;
            });

            const totalAttendanceDays = students.length * daysInMonth;
            const averageAttendanceRate = totalAttendanceDays > 0 ? 
                (((totalPresent + totalLate) / totalAttendanceDays) * 100).toFixed(1) : 0;

            return {
                studentData,
                totalPresent,
                totalAbsent,
                totalLate,
                averageAttendanceRate
            };
        }

