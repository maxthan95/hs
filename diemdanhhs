<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phần mềm điểm danh học sinh</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        .tabs {
            display: flex;
            background: #f8f9fa;
            border-bottom: 2px solid #e9ecef;
        }

        .tab {
            flex: 1;
            padding: 15px 20px;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            color: #6c757d;
            transition: all 0.3s ease;
        }

        .tab.active {
            background: white;
            color: #4facfe;
            border-bottom: 3px solid #4facfe;
        }

        .tab:hover:not(.active) {
            background: #e9ecef;
            color: #495057;
        }

        .tab-content {
            display: none;
            padding: 30px;
        }

        .tab-content.active {
            display: block;
        }

        .form-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 25px;
            border-left: 4px solid #4facfe;
        }

        .form-section h3 {
            color: #495057;
            margin-bottom: 20px;
            font-size: 1.3rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .form-group input,
        .form-group select {
            padding: 12px 15px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: white;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #4facfe;
            box-shadow: 0 0 0 3px rgba(79, 172, 254, 0.1);
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(79, 172, 254, 0.3);
        }

        .btn-success {
            background: linear-gradient(135deg, #56ab2f 0%, #a8e6cf 100%);
            color: white;
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(86, 171, 47, 0.3);
        }

        .btn-info {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-info:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .student-list {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .student-list h3 {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 20px;
            margin: 0;
            font-size: 1.3rem;
        }

        .student-item {
            padding: 20px;
            border-bottom: 1px solid #e9ecef;
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            transition: all 0.3s ease;
        }

        .student-item:hover {
            background: #f8f9fa;
        }

        .student-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }

        .student-detail {
            display: flex;
            flex-direction: column;
        }

        .student-detail strong {
            color: #495057;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }

        .student-detail span {
            color: #6c757d;
            font-size: 1rem;
        }

        .attendance-controls {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .attendance-status {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            border: 2px solid transparent;
        }

        .status-present {
            background: #d4edda;
            color: #155724;
            border-color: #c3e6cb;
        }

        .status-absent {
            background: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
        }

        .status-late {
            background: #fff3cd;
            color: #856404;
            border-color: #ffeaa7;
        }

        .quick-actions {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stats-card {
            background: white;
            border-radius: 10px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-left: 4px solid #4facfe;
        }

        .stats-card h4 {
            color: #495057;
            margin-bottom: 10px;
            font-size: 1rem;
        }

        .stats-card .number {
            font-size: 2.5rem;
            font-weight: bold;
            color: #4facfe;
            margin-bottom: 5px;
        }

        .stats-card .label {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .date-filter {
            background: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .filter-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            align-items: end;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.3;
        }

        .empty-state h3 {
            margin-bottom: 10px;
            color: #495057;
        }

        @media (max-width: 768px) {
            .tabs {
                flex-direction: column;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .student-info {
                grid-template-columns: 1fr;
            }

            .attendance-controls {
                justify-content: center;
            }

            .quick-actions {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📚 Phần mềm điểm danh học sinh</h1>
            <p>Quản lý và thống kê điểm danh một cách chuyên nghiệp</p>
        </div>

        <div class="tabs">
            <button class="tab active" onclick="showTab('students')">👥 Quản lý học sinh</button>
            <button class="tab" onclick="showTab('attendance')">📝 Điểm danh</button>
            <button class="tab" onclick="showTab('daily-stats')">📊 Thống kê hàng ngày</button>
            <button class="tab" onclick="showTab('monthly-stats')">📈 Thống kê hàng tháng</button>
        </div>

        <!-- Tab Quản lý học sinh -->
        <div id="students" class="tab-content active">
            <div class="form-section">
                <h3>📁 Nhập danh sách từ Excel</h3>
                <div class="form-row">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Chọn file Excel (*.xlsx, *.xls)</label>
                        <input type="file" id="excelFile" accept=".xlsx,.xls" onchange="handleExcelUpload(event)">
                        <small style="color: #6c757d; margin-top: 5px; display: block;">
                            📋 File Excel cần có các cột: <strong>Họ và tên, Lớp, Ngày sinh, Giới tính, Loại học sinh</strong>
                        </small>
                    </div>
                </div>
                <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">
                    <button class="btn btn-success" onclick="importStudentsFromExcel()">
                        📥 Nhập từ Excel
                    </button>
                    <button class="btn btn-info" onclick="downloadExcelTemplate()">
                        📄 Tải mẫu Excel
                    </button>
                    <span id="importStatus" style="color: #28a745; font-weight: bold;"></span>
                </div>
            </div>

            <div class="form-section">
                <h3>➕ Thêm học sinh mới</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label>Họ và tên</label>
                        <input type="text" id="studentName" placeholder="Nhập họ và tên học sinh">
                    </div>
                    <div class="form-group">
                        <label>Lớp</label>
                        <input type="text" id="studentClass" placeholder="Ví dụ: 6A1">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Ngày sinh</label>
                        <input type="date" id="studentBirthDate">
                    </div>
                    <div class="form-group">
                        <label>Giới tính</label>
                        <select id="studentGender">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Loại học sinh</label>
                        <select id="studentType">
                            <option value="">-- Chọn loại --</option>
                            <option value="Bán trú">Bán trú</option>
                            <option value="Không bán trú">Không bán trú</option>
                        </select>
                    </div>
                </div>
                <button class="btn btn-primary" onclick="addStudent()">➕ Thêm học sinh</button>
            </div>

            <div class="student-list">
                <h3>📋 Danh sách học sinh</h3>
                <div id="studentsList"></div>
            </div>
        </div>

        <!-- Tab Điểm danh -->
        <div id="attendance" class="tab-content">
            <div class="quick-actions">
                <button class="btn btn-success" onclick="markAllPresent()">✅ Tất cả có mặt</button>
                <button class="btn btn-info" onclick="exportAttendanceToExcel()">📁 Xuất Excel</button>
                <button class="btn btn-primary" onclick="saveData(true)">💾 Lưu điểm danh</button>
                <button class="btn" style="background: #6c757d; color: white;" onclick="showSaveLog()">📋 Nhật ký lưu</button>
            </div>

            <div class="date-filter">
                <h4>📅 Chọn ngày điểm danh</h4>
                <div class="filter-row">
                    <div class="form-group">
                        <label>Ngày điểm danh</label>
                        <input type="date" id="attendanceDate" onchange="loadAttendanceForDate()">
                    </div>
                </div>
            </div>

            <div class="student-list">
                <h3>👨‍🎓 Điểm danh học sinh</h3>
                <div id="attendanceList"></div>
            </div>
        </div>

        <!-- Tab Thống kê hàng ngày -->
        <div id="daily-stats" class="tab-content">
            <div class="date-filter">
                <div class="filter-row">
                    <div class="form-group">
                        <label>Chọn ngày thống kê</label>
                        <input type="date" id="dailyStatsDate" onchange="loadDailyStats()">
                    </div>
                    <div class="form-group">
                        <button class="btn btn-info" onclick="loadDailyStats()">📊 Xem thống kê</button>
                        <button class="btn btn-success" onclick="exportDailyStatsToExcel()">📁 Xuất Excel</button>
                    </div>
                </div>
            </div>

            <div class="stats-grid" id="dailyStatsGrid"></div>
            <div class="student-list" id="dailyStatsList"></div>
        </div>

        <!-- Tab Thống kê hàng tháng -->
        <div id="monthly-stats" class="tab-content">
            <div class="date-filter">
                <div class="filter-row">
                    <div class="form-group">
                        <label>Chọn tháng/năm</label>
                        <input type="month" id="monthlyStatsDate" onchange="loadMonthlyStats()">
                    </div>
                    <div class="form-group">
                        <button class="btn btn-info" onclick="loadMonthlyStats()">📈 Xem thống kê</button>
                        <button class="btn btn-success" onclick="exportMonthlyStatsToExcel()">📁 Xuất Excel</button>
                    </div>
                </div>
            </div>

            <div class="stats-grid" id="monthlyStatsGrid"></div>
            <div class="student-list" id="monthlyStatsList"></div>
        </div>
    </div>

    <script>
        // Biến lưu dữ liệu Excel
        let excelData = [];

        // Xử lý upload file Excel
        function handleExcelUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    
                    // Đọc sheet đầu tiên
                    const sheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[sheetName];
                    
                    // Chuyển đổi thành JSON
                    const jsonData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
                    
                    if (jsonData.length < 2) {
                        alert('File Excel không có dữ liệu hoặc chỉ có header!');
                        return;
                    }
                    
                    // Lấy header (dòng đầu tiên)
                    const headers = jsonData[0].map(h => h ? h.toString().trim().toLowerCase() : '');
                    
                    // Tìm vị trí các cột cần thiết
                    const columnMap = findColumnIndexes(headers);
                    
                    if (!validateColumns(columnMap)) {
                        alert('File Excel thiếu các cột bắt buộc!\nCần có: Họ và tên, Lớp, Ngày sinh, Giới tính, Loại học sinh');
                        return;
                    }
                    
                    // Xử lý dữ liệu từ dòng thứ 2 trở đi
                    excelData = [];
                    for (let i = 1; i < jsonData.length; i++) {
                        const row = jsonData[i];
                        if (!row || row.length === 0) continue;
                        
                        const studentData = extractStudentData(row, columnMap);
                        if (studentData && validateStudentData(studentData)) {
                            excelData.push(studentData);
                        }
                    }
                    
                    if (excelData.length === 0) {
                        alert('Không tìm thấy dữ liệu hợp lệ trong file Excel!');
                        return;
                    }
                    
                    document.getElementById('importStatus').textContent = 
                        `✅ Đã tải ${excelData.length} học sinh từ file Excel. Nhấn "Nhập từ Excel" để thêm vào hệ thống.`;
                    
                } catch (error) {
                    console.error('Lỗi đọc file Excel:', error);
                    alert('Có lỗi khi đọc file Excel. Vui lòng kiểm tra định dạng file!');
                }
            };
            
            reader.readAsArrayBuffer(file);
        }

        // Tìm vị trí các cột trong Excel
        function findColumnIndexes(headers) {
            const columnMap = {};
            
            // Danh sách các tên cột có thể có
            const columnVariants = {
                name: ['họ và tên', 'họ tên', 'tên', 'fullname', 'name', 'ho va ten', 'ho ten'],
                class: ['lớp', 'lop', 'class', 'classroom'],
                birthDate: ['ngày sinh', 'ngay sinh', 'birth date', 'birthdate', 'date of birth', 'sinh'],
                gender: ['giới tính', 'gioi tinh', 'gender', 'sex', 'phai'],
                type: ['loại học sinh', 'loai hoc sinh', 'loại', 'loai', 'type', 'student type', 'ban tru']
            };
            
            // Tìm index cho từng cột
            Object.keys(columnVariants).forEach(key => {
                const variants = columnVariants[key];
                for (let i = 0; i < headers.length; i++) {
                    if (variants.some(variant => headers[i].includes(variant))) {
                        columnMap[key] = i;
                        break;
                    }
                }
            });
            
            return columnMap;
        }

        // Kiểm tra các cột bắt buộc
        function validateColumns(columnMap) {
            return columnMap.name !== undefined && 
                   columnMap.class !== undefined && 
                   columnMap.birthDate !== undefined && 
                   columnMap.gender !== undefined && 
                   columnMap.type !== undefined;
        }

        // Trích xuất dữ liệu học sinh từ dòng Excel
        function extractStudentData(row, columnMap) {
            try {
                const name = row[columnMap.name] ? row[columnMap.name].toString().trim() : '';
                const studentClass = row[columnMap.class] ? row[columnMap.class].toString().trim() : '';
                const birthDate = parseBirthDate(row[columnMap.birthDate]);
                const gender = normalizeGender(row[columnMap.gender]);
                const type = normalizeStudentType(row[columnMap.type]);
                
                if (!name || !studentClass || !birthDate || !gender || !type) {
                    return null;
                }
                
                return {
                    name: name,
                    class: studentClass,
                    birthDate: birthDate,
                    gender: gender,
                    type: type
                };
            } catch (error) {
                console.error('Lỗi trích xuất dữ liệu:', error);
                return null;
            }
        }

        // Chuyển đổi ngày sinh từ Excel
        function parseBirthDate(dateValue) {
            if (!dateValue) return null;
            
            try {
                // Nếu là số (Excel date serial)
                if (typeof dateValue === 'number') {
                    const excelEpoch = new Date(1900, 0, 1);
                    const date = new Date(excelEpoch.getTime() + (dateValue - 2) * 24 * 60 * 60 * 1000);
                    return date.toISOString().split('T')[0];
                }
                
                // Nếu là chuỗi
                const dateStr = dateValue.toString().trim();
                
                // Thử các định dạng phổ biến
                const formats = [
                    /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/, // dd/mm/yyyy
                    /^(\d{1,2})-(\d{1,2})-(\d{4})$/,  // dd-mm-yyyy
                    /^(\d{4})\/(\d{1,2})\/(\d{1,2})$/, // yyyy/mm/dd
                    /^(\d{4})-(\d{1,2})-(\d{1,2})$/   // yyyy-mm-dd
                ];
                
                for (let format of formats) {
                    const match = dateStr.match(format);
                    if (match) {
                        let day, month, year;
                        
                        if (format.toString().includes('^(\\d{4})')) {
                            // yyyy/mm/dd or yyyy-mm-dd
                            year = parseInt(match[1]);
                            month = parseInt(match[2]);
                            day = parseInt(match[3]);
                        } else {
                            // dd/mm/yyyy or dd-mm-yyyy
                            day = parseInt(match[1]);
                            month = parseInt(match[2]);
                            year = parseInt(match[3]);
                        }
                        
                        // Tạo date object và chuyển thành format yyyy-mm-dd
                        const date = new Date(year, month - 1, day);
                        if (date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day) {
                            return date.toISOString().split('T')[0];
                        }
                    }
                }
                
                // Thử parse trực tiếp
                const date = new Date(dateStr);
                if (!isNaN(date.getTime())) {
                    return date.toISOString().split('T')[0];
                }
                
            } catch (error) {
                console.error('Lỗi parse ngày sinh:', error);
            }
            
            return null;
        }

        // Chuẩn hóa giới tính
        function normalizeGender(genderValue) {
            if (!genderValue) return null;
            
            const gender = genderValue.toString().trim().toLowerCase();
            
            if (gender.includes('nam') || gender.includes('male') || gender === 'm') {
                return 'Nam';
            } else if (gender.includes('nữ') || gender.includes('nu') || gender.includes('female') || gender === 'f') {
                return 'Nữ';
            }
            
            return null;
        }

        // Chuẩn hóa loại học sinh
        function normalizeStudentType(typeValue) {
            if (!typeValue) return null;
            
            const type = typeValue.toString().trim().toLowerCase();
            
            if (type.includes('bán trú') || type.includes('ban tru') || type.includes('semi-boarding')) {
                return 'Bán trú';
            } else if (type.includes('không bán trú') || type.includes('khong ban tru') || type.includes('day student')) {
                return 'Không bán trú';
            }
            
            return null;
        }

        // Kiểm tra tính hợp lệ của dữ liệu học sinh
        function validateStudentData(studentData) {
            return studentData.name.length > 0 && 
                   studentData.class.length > 0 && 
                   studentData.birthDate && 
                   ['Nam', 'Nữ'].includes(studentData.gender) && 
                   ['Bán trú', 'Không bán trú'].includes(studentData.type);
        }

        // Nhập học sinh từ Excel vào hệ thống
        function importStudentsFromExcel() {
            if (!Array.isArray(excelData) || excelData.length === 0) {
                alert('Vui lòng chọn và tải file Excel trước!');
                return;
            }
            
            // Đảm bảo students là mảng
            if (!Array.isArray(students)) {
                students = [];
            }
            
            let addedCount = 0;
            let duplicateCount = 0;
            
            excelData.forEach(studentData => {
                // Kiểm tra trùng lặp (theo tên và lớp)
                const isDuplicate = students.some(s => 
                    s.name.toLowerCase() === studentData.name.toLowerCase() && 
                    s.class.toLowerCase() === studentData.class.toLowerCase()
                );
                
                if (!isDuplicate) {
                    const student = {
                        id: Date.now() + Math.random(), // Đảm bảo ID unique
                        ...studentData
                    };
                    students.push(student);
                    addedCount++;
                } else {
                    duplicateCount++;
                }
            });
            
            // Cập nhật giao diện
            displayStudents();
            loadAttendanceForDate();
            saveData(true); // Hiển thị thông báo khi nhập từ Excel
            
            // Reset form
            document.getElementById('excelFile').value = '';
            excelData = [];
            document.getElementById('importStatus').textContent = '';
            
            // Thông báo kết quả
            let message = `✅ Đã nhập thành công ${addedCount} học sinh!`;
            if (duplicateCount > 0) {
                message += `\n⚠️ Bỏ qua ${duplicateCount} học sinh trùng lặp.`;
            }
            alert(message);
        }

        // Tải file mẫu Excel
        function downloadExcelTemplate() {
            const templateData = [
                ['Họ và tên', 'Lớp', 'Ngày sinh', 'Giới tính', 'Loại học sinh'],
                ['Nguyễn Văn An', '6A1', '15/03/2011', 'Nam', 'Bán trú'],
                ['Trần Thị Bình', '6A1', '20/05/2011', 'Nữ', 'Không bán trú'],
                ['Lê Minh Cường', '6A2', '10/07/2011', 'Nam', 'Bán trú'],
                ['Phạm Thị Dung', '6A2', '25/09/2011', 'Nữ', 'Không bán trú']
            ];
            
            const ws = XLSX.utils.aoa_to_sheet(templateData);
            
            // Định dạng header
            const headerRange = XLSX.utils.decode_range(ws['!ref']);
            for (let col = headerRange.s.c; col <= headerRange.e.c; col++) {
                const cellAddress = XLSX.utils.encode_cell({ r: 0, c: col });
                if (!ws[cellAddress]) continue;
                ws[cellAddress].s = {
                    font: { bold: true, color: { rgb: "FFFFFF" } },
                    fill: { fgColor: { rgb: "4facfe" } },
                    alignment: { horizontal: "center" }
                };
            }
            
            // Điều chỉnh độ rộng cột
            ws['!cols'] = [
                { wch: 20 }, // Họ và tên
                { wch: 10 }, // Lớp
                { wch: 15 }, // Ngày sinh
                { wch: 12 }, // Giới tính
                { wch: 18 }  // Loại học sinh
            ];
            
            // Thêm ghi chú
            const noteData = [
                [],
                ['GHI CHÚ:'],
                ['- Ngày sinh: dd/mm/yyyy (ví dụ: 15/03/2011)'],
                ['- Giới tính: Nam hoặc Nữ'],
                ['- Loại học sinh: "Bán trú" hoặc "Không bán trú"'],
                ['- Không được để trống các cột bắt buộc'],
                ['- Có thể thêm nhiều dòng dữ liệu']
            ];
            
            // Thêm ghi chú vào sheet
            const currentRange = XLSX.utils.decode_range(ws['!ref']);
            const startRow = currentRange.e.r + 2;
            
            noteData.forEach((row, index) => {
                if (row.length > 0) {
                    const cellAddress = XLSX.utils.encode_cell({ r: startRow + index, c: 0 });
                    ws[cellAddress] = { v: row[0], t: 's' };
                    if (index === 1) { // Header ghi chú
                        ws[cellAddress].s = { font: { bold: true, color: { rgb: "FF0000" } } };
                    }
                }
            });
            
            // Cập nhật range
            const newRange = XLSX.utils.encode_range({
                s: { r: 0, c: 0 },
                e: { r: startRow + noteData.length - 1, c: 4 }
            });
            ws['!ref'] = newRange;
            
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Danh sách học sinh");
            
            XLSX.writeFile(wb, "Mau_danh_sach_hoc_sinh.xlsx");
        }

